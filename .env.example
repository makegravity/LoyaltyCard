# Copy to .env next to docker-compose.yml, fill in, and keep it private (chmod 600 .env).
# Never commit it.

# The domain people open. Its DNS must point at this server; Caddy gets the https certificate.
SITE_DOMAIN=maniacrewards.com

# Database. Use long random values, e.g. from:
#   openssl rand -base64 24
DB_NAME=binmania
DB_USER=binmania
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Encrypts the Stripe keys the super admin saves. 64 hex characters, from:
#   openssl rand -hex 32
# Keep a copy somewhere safe: without it the saved Stripe keys must be entered again.
SECRETS_KEY=

# First start only, when the database has no admin yet (not needed when importing the
# prototype's data). This first account is the super admin and must choose a new password at first sign-in; then delete
# ADMIN_PASSWORD from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The mailbox that sends password reset links. For Gmail: turn on 2-Step Verification for
# the account, then make an app password at https://myaccount.google.com/apppasswords and
# paste it here (with or without its spaces). Leave both empty to turn reset emails off.
FORGOT_EMAIL=
FORGOT_EMAIL_APP_PASSWORD=
# Only for a provider other than Gmail (default smtp.gmail.com, port 465).
#SMTP_HOST=
#SMTP_PORT=

# How many days of daily database backups to keep in ./backups.
BACKUP_KEEP_DAYS=14
