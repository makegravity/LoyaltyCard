{
  "name": "binmania-loyalty",
  "version": "0.2.0",
  "private": true,
  "description": "Bin Mania membership: sign-up, payments (demo for now), selfie, rotating QR card, offers feed, billing, and staff logins for admins and cashiers.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch-path=server.js --watch-path=lib server.js",
    "import-json": "node --env-file-if-exists=.env scripts/import-json.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4"
  }
}
