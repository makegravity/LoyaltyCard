{
  "name": "binmania-loyalty",
  "version": "0.3.0",
  "private": true,
  "description": "Bin Mania membership: sign-up (online or at the counter), Stripe payments, selfie, rotating QR card, offers feed, billing, and staff logins for cashiers, admins and super admins.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch-path=server.js --watch-path=lib server.js",
    "import-json": "node --env-file-if-exists=.env scripts/import-json.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jpeg-js": "0.4.4",
    "mysql2": "^3.24.6",
    "nodemailer": "10.2.1",
    "onnxruntime-web": "1.30.0",
    "pngjs": "7.0.0",
    "qrcode": "^1.5.4",
    "stripe": "23.0.1"
  }
}
